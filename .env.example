# URL base de la API del Backend.
# Para desarrollo local: http://localhost:8000/api
# Para producción: https://apiskills.danidev.co/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Configuración de Firebase (obtener de la consola de Firebase -> Configuración del Proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id

# Configuración del Asistente Gemini AI (Servidor únicamente, NO usar el prefijo NEXT_PUBLIC_)
GEMINI_API_KEY=tu_api_key_de_gemini
